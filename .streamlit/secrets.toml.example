# Copy this file to .streamlit/secrets.toml and add your real values.
# secrets.toml is ignored by Git and must never be committed.
OPENAI_API_KEY = "replace-with-your-own-key"
OPENAI_MODEL = "gpt-5.6-luna"

# Optional: hosted Postgres (e.g. Neon). Without it, a local SQLite file is used.
# DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# Optional but recommended on public deployments: gates meet import/removal.
# Without it, anyone who can reach the app can modify the shared data.
# ADMIN_PASSWORD = "choose-a-strong-password"
