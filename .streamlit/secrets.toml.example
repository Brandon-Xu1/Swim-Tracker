# Copy to secrets.toml (ignored by Git); enter real secrets only in that file.
OPENAI_API_KEY = "replace-with-your-own-key"
OPENAI_MODEL = "gpt-5.6-luna"
AI_DAILY_CALL_LIMIT = "200"

# Optional hosted storage. Otherwise local SQLite is used.
# DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# Public sample writes are locked by default. Team owners/coaches can import privately.
# ADMIN_PASSWORD = "choose-a-strong-password"
# Local development ONLY: bypass the public admin gate.
# ALLOW_PUBLIC_WRITES = "true"
